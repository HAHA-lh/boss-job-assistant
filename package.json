{
  "name": "boss-job-assistant",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:version": "node scripts/check-version.mjs",
    "build": "npm run check:version && tsc --noEmit && vite build && node scripts/finalize-build.mjs && node scripts/verify-dist.mjs",
    "ci": "npm test && npm run build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mammoth": "^1.10.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.2",
    "@types/chrome": "^0.1.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
